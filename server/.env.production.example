# =============================================================================
# SyncSpace — Production Environment Variables
# Render (backend) deployment reference
# =============================================================================
# Copy this file to .env and fill in every value before deploying.
# Never commit the filled-in .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the Express server listens on.
# Render sets this automatically — leave as 10000 or omit entirely.
PORT=10000

# Node environment. Must be "production" in deployed environments to:
#   • Enable secure cookies (HTTPS-only)
#   • Suppress stack traces in error responses
#   • Enforce CORS allowlist (no wildcard)
NODE_ENV=production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Obtain from: Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/syncspace?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Authentication — JWT
# -----------------------------------------------------------------------------

# Secret for signing short-lived ACCESS tokens (15-minute expiry).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be different from JWT_REFRESH_SECRET.
JWT_ACCESS_SECRET=<generate-64-random-bytes-hex>

# Secret for signing long-lived REFRESH tokens (7-day expiry, stored in httpOnly cookie).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=<generate-64-random-bytes-hex>

# Legacy secret kept for zero-downtime migration of existing sessions.
# Used as fallback if JWT_ACCESS_SECRET is absent. Remove once all users
# have re-authenticated under the new token scheme.
JWT_SECRET=<your-existing-jwt-secret>

# -----------------------------------------------------------------------------
# CSRF Protection
# -----------------------------------------------------------------------------

# Secret used by csrf-csrf to sign CSRF double-submit cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=<generate-32-random-bytes-hex>

# -----------------------------------------------------------------------------
# CORS / Frontend
# -----------------------------------------------------------------------------

# The URL of your frontend deployment (Vercel).
# Used to:
#   • Whitelist CORS origins (no wildcard in production)
#   • Build invite link URLs
# Do NOT include a trailing slash.
# Multiple origins can be comma-separated: https://app.example.com,https://www.example.com
CLIENT_URL=https://<your-app>.vercel.app

# -----------------------------------------------------------------------------
# AI — Google Gemini (primary)
# -----------------------------------------------------------------------------

# API key for Google AI Studio / Gemini API.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# Gemini model to use. Default is gemini-2.0-flash (fast and cheap).
# Other options: gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# AI — Groq / Llama (fallback)
# -----------------------------------------------------------------------------

# API key for Groq Cloud (used when Gemini fails or quota is exceeded).
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>

# Groq model to use. Default is llama-3.3-70b-versatile.
# Other options: llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# =============================================================================
# Security checklist before going live:
#   [ ] JWT_ACCESS_SECRET  ≥ 64 random bytes, unique
#   [ ] JWT_REFRESH_SECRET ≥ 64 random bytes, unique, different from ACCESS
#   [ ] CSRF_SECRET        ≥ 32 random bytes, unique
#   [ ] CLIENT_URL         exact Vercel deployment URL, no trailing slash
#   [ ] NODE_ENV           set to "production"
#   [ ] MONGODB_URI        Atlas connection string with Atlas IP whitelist set
#   [ ] Render → Settings → "Auto Deploy" enabled after env vars are saved
# =============================================================================
